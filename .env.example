# Upstream API origin for Next.js rewrites: /api/meriai/* → this host.
# Local:
API_BASE_URL=http://localhost:8000
# Hosted (Render):
# API_BASE_URL=https://meriai-api.onrender.com

# Browser REST base (default /api/meriai via next.config rewrite).
# NEXT_PUBLIC_API_BASE_URL=/api/meriai
# Or call the API directly (requires CORS ALLOWED_ORIGINS on the backend):
# NEXT_PUBLIC_API_BASE_URL=https://meriai-api.onrender.com

# Absolute WebSocket origin (required when REST uses the /api/meriai proxy).
# NEXT_PUBLIC_WS_BASE_URL=https://meriai-api.onrender.com

# Optional hosting URL for self-referential links (not used by the MeriAI client).
# APP_URL=http://localhost:3000

# Optional: disable webpack HMR in constrained preview hosts.
# DISABLE_HMR=true
