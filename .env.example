# Public MeriAI API origin. The production default is
# https://meriai-api.onrender.com; set this only to override it (for example,
# for a staging API). Do not put provider or portal credentials in the frontend.
API_BASE_URL="https://meriai-api.onrender.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
